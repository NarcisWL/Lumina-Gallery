{
  "name": "luvia-gallery",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "exif-parser": "^0.1.12",
    "exifr": "^7.1.3",
    "express": "^4.18.2",
    "framer-motion": "^12.23.25",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.556.0",
    "mime-types": "^2.1.35",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-virtualized-auto-sizer": "^1.0.25",
    "react-window": "^1.8.10"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^1.6.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "node server.js",
    "build": "vite build",
    "test:background": "node --test test/background-file-walker.test.js",
    "test": "npm run test:backend && npm run test:frontend",
    "eject": "react-scripts eject",
    "serve": "node server.js",
    "fix-structure": "mkdir -p src public && [ -f index.html ] && mv index.html public/ || true && [ -f metadata.json ] && mv metadata.json public/ || true && [ -f App.tsx ] && mv *.tsx *.ts components utils src/ || true",
    "test:backend": "node --test test/*.test.js",
    "test:frontend": "vitest run"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
